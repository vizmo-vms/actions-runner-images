# Tool versions baked into the Azure runner images. The first block matches the ARC Dockerfile; keep them in step
# until ARC is retired. Tools not pinned here (the GitHub runner, gh, yq, rustup) install their latest release, and the
# nightly build picks up new ones.
NVM_VERSION=v0.40.8
NODE_VERSION=24.22.1
PNPM_VERSION=11.0.0
TEMPORAL_CLI_VERSION=1.9.1
DEVSPACE_VERSION=v6.3.21
RANCHER_CLI_VERSION=v2.9.5
KUBECTL_VERSION=v1.35.9
DOCKER_COMPOSE_VERSION=v5.6.0

# Pre-filled tool cache, so actions/setup-* find these without downloading. Node 24 resolves to NODE_VERSION.
TOOLCACHE_NODE_VERSIONS="24.22.1 24.21.0"
TOOLCACHE_PYTHON_SERIES="3.11"
TOOLCACHE_RUBY_SERIES="3.3"
TOOLCACHE_JAVA_MAJORS="17"

# Flutter and the Android build of vizmo-vms/flutter (kiosk and mobile apps).
FLUTTER_VERSION=3.47.6
# The cmdline-tools android-actions/setup-android@v4 pins (22.0), so it reuses this copy. 23.0 hands sdkmanager to
# the Android CLI, whose SDK metadata AGP 9.0 cannot read.
ANDROID_CMDLINE_TOOLS=15859902
ANDROID_COMPILE_SDK=37
# compileSdk release(37) { minorApiLevel = 0 } builds against this SDK package.
ANDROID_PLATFORM=android-37.0
GRADLE_VERSION=9.1.0
AGP_VERSION=9.0.1
KOTLIN_VERSION=2.3.20

# Playwright versions the lockfiles pin; each brings its own Chromium build. Every runner: secure-plan (1.63.0, medium)
# and platform (1.60.0, 1.52.0). runner-large adds argus (1.61.1), whose jobs all run on large.
PLAYWRIGHT_VERSIONS="1.63.0 1.60.0 1.52.0"
PLAYWRIGHT_VERSIONS_LARGE="1.61.1"
